IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 NanjingMetro"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "NanjingMetro，版本 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "版权所有 (C) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog: 历史记录与收藏夹
//

IDD_DIALOG_HISTORY DIALOGEX 0, 0, 540, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "历史记录与收藏夹"
FONT 9, "Microsoft YaHei UI", 0, 0, 0x1
BEGIN
    LTEXT "",IDC_HISTORY_HINT,12,10,516,30,SS_NOPREFIX | SS_LEFT
    CONTROL "路线列表",IDC_HISTORY_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,12,46,516,182
    PUSHBUTTON "取消收藏(&F)",IDC_HISTORY_TOGGLE_FAV,12,242,105,24
    DEFPUSHBUTTON "查询选中路线(&Q)",IDC_HISTORY_QUERY,125,242,122,24
    PUSHBUTTON "清空历史(&C)",IDC_HISTORY_CLEAR,255,242,90,24
    PUSHBUTTON "关闭(&X)",IDCANCEL,448,242,80,24
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog: 路线规划结果
//

IDD_DIALOG_PATH_RESULT DIALOGEX 0, 0, 420, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "路线规划结果"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "行程概览",IDC_STATIC,7,9,60,8
    LTEXT           "",IDC_RESULT_SUMMARY,7,20,406,40,SS_NOPREFIX | SS_LEFT
    LTEXT           "换乘指引",IDC_STATIC,7,68,60,8
    EDITTEXT        IDC_RESULT_GUIDE,7,79,406,175,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "收藏此路线(&F)",IDC_RESULT_FAV,7,262,90,14
    DEFPUSHBUTTON   "关闭(&C)",IDOK,343,262,70,14
END
/////////////////////////////////////////////////////////////////////////////
//
// Dialog: 站点搜索
//

IDD_STATION_SEARCH_DLG DIALOGEX 0, 0, 570, 342
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "站点与地标查询"
FONT 9, "Microsoft YaHei UI", 0, 0, 0x1
BEGIN
    LTEXT "站名 / 地标",IDC_STATIC,12,14,60,12
    EDITTEXT IDC_EDIT_STATION_SEARCH,78,10,390,20,ES_AUTOHSCROLL
    PUSHBUTTON "搜索(&S)",IDC_BUTTON_STATION_SEARCH,478,10,80,20
    LTEXT "搜索结果 · 单击查看 / 双击定位",IDC_STATIC,12,40,232,12
    LTEXT "站点详情 · 首末班车与周边",IDC_STATIC,272,40,286,12
    LISTBOX IDC_LIST_STATION_RESULTS,12,58,246,224,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    EDITTEXT IDC_LIST_STATION_DETAILS,272,58,286,224,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT "",IDC_STATIC_SEARCH_HINT,12,288,546,22,SS_NOPREFIX | SS_LEFT
    DEFPUSHBUTTON "定位到地图(&O)",IDC_BUTTON_SELECT_STATION,384,314,96,20
    PUSHBUTTON "关闭(&C)",IDCANCEL,490,314,68,20
END


